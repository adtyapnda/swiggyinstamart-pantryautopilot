# =============================================================================
# Swiggy Builders Club MCP — OAuth 2.1 + PKCE
# =============================================================================
# For local dev these point at the mock OAuth endpoints in
# netlify/functions/. For prod, point them at Swiggy and set
# SWIGGY_CLIENT_ID once whitelisted at https://mcp.swiggy.com/builders/access/.

SWIGGY_AUTHORIZE_URL=http://localhost:3000/mock/authorize
SWIGGY_TOKEN_URL=http://localhost:3000/mock/token
SWIGGY_CLIENT_ID=dev-mock
SWIGGY_REDIRECT_URI=http://localhost:3000/auth/swiggy/callback

# Production values (set in Netlify UI, do not commit):
# SWIGGY_AUTHORIZE_URL=https://mcp.swiggy.com/auth/authorize
# SWIGGY_TOKEN_URL=https://mcp.swiggy.com/auth/token
# SWIGGY_CLIENT_ID=<your-client-id-from-builders-access>
# SWIGGY_REDIRECT_URI=https://swiggyinstamart-pantryautopilot.netlify.app/auth/swiggy/callback

# =============================================================================
# MCP client wrapper
# =============================================================================

# Swiggy MCP exposes three independent servers — Instamart (groceries),
# Food (restaurants), and Dineout (reservations) — addressed as
# https://mcp.swiggy.com/{server}. Pantry Autopilot uses Instamart and Food.
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com
# Set MCP_USE_FAKE=1 to bypass the real MCP and use the FakeMCPClient
# (returns fixture data — useful before approval and for tests).
MCP_USE_FAKE=1

# =============================================================================
# WhatsApp Business Cloud API (Meta)
# =============================================================================
# Get these from https://developers.facebook.com — your app's WhatsApp
# settings. WHATSAPP_VERIFY_TOKEN: pick any random secret; paste the same
# value into the Meta webhook config to complete the GET handshake at
# /whatsapp/webhook.

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Set WHATSAPP_USE_MOCK=1 to log outbound messages instead of POSTing to
# graph.facebook.com — useful when developing without Meta credentials.
WHATSAPP_USE_MOCK=1

# =============================================================================
# Supabase (optional — Netlify Blobs is the fallback storage)
# =============================================================================
# Provision at https://supabase.com, run migrations/001_init.sql in the SQL
# editor, then set these to enable persistent multi-user storage. Until
# then, the app uses Blobs with a single dev key.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte AES-256-GCM key for app-layer encryption of stored access tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
